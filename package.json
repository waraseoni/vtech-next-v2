{
  "name": "vtech-next-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:lhci": "lhci autorun",
    "size": "node --max-old-space-size=4096 ./node_modules/size-limit/bin.js",
    "analyze": "node scripts/analyze.mjs",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "7.0.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.106.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "web-vitals": "6.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@next/bundle-analyzer": "16.4.5",
    "@playwright/test": "1.65.0",
    "@size-limit/preset-app": "14.3.0",
    "@tailwindcss/turbopack": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "license-checker": "25.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "size-limit": "14.3.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "size-limit": [
    {
      "name": "shared chunks",
      "path": ".next/static/chunks/*.js",
      "limit": "320 kB"
    },
    {
      "name": "global css",
      "path": ".next/static/chunks/*.css",
      "limit": "60 kB"
    }
  ]
}
